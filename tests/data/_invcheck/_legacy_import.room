C {analogLib/INCLSCR.sym} 390 -100 0 0 {name=INCLSCR1 value=".lib cornerMOSlv.lib mos_tt" only_toplevel=true qucs.type=INCLSCR rotate=0 mirror=0 core.primitive=analogLib/INCLSCR.symbol.core core.primitive=analogLib/INCLSCR.symbol.core}
C {analogLib/TR.sym} 400 30 0 0 {name=TR1 value=".control
save all
tran 50n 2u
write test_inverter.raw
.endc" only_toplevel=true qucs.type=.TR rotate=0 mirror=0 core.primitive=analogLib/TR.symbol.core core.primitive=analogLib/TR.symbol.core}
C {vsource.sym} 70 -110 0 0 {name=Vdd value=1.2 qucs.type=Vdc rotate=1 mirror=0 core.primitive=analogLib/Vdc.symbol.core}
C {gnd.sym} 110 -50 0 0 {name=* lab=GND qucs.type=GND rotate=0 mirror=0 core.primitive=analogLib/GND.symbol.core}
C {vsource.sym} 150 -110 0 0 {name=Vin value="PULSE(0 1.2 0.5u 10n 10n 1u 2u)" qucs.type=Vpulse rotate=1 mirror=0 core.primitive=analogLib/Vpulse.symbol.core}
